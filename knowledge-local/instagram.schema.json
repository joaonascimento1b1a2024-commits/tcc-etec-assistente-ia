{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "texto",
    "url",
    "data_publicacao",
    "vigencia_fim",
    "status",
    "revisor",
    "semDadosPessoais"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ig-[a-z0-9-]+$"
    },
    "texto": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "url": {
      "type": "string",
      "pattern": "^https://www\\.instagram\\.com/(p|reel)/"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date"
    },
    "vigencia_fim": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "pendente",
        "em_revisao",
        "aprovado",
        "conflito",
        "expirado"
      ]
    },
    "revisor": {
      "type": [
        "string",
        "null"
      ]
    },
    "semDadosPessoais": {
      "const": true
    }
  }
}
