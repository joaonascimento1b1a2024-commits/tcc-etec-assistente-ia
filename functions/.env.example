# Remetente e credenciais SMTP são configurados na extensão Trigger Email.
AVISOS_SITE_URL="https://tcc-ia-d8891.web.app"

# Origem HTTPS da Home, somente apos confirmacao; vazio bloqueia navegadores.
ASSISTENTE_CORS_ORIGINS=

# Configuracao IA compartilhada com o runtime Render (nao habilita deploy Firebase).
# Para Render, cadastrar diretamente no painel; ver render-poc/OPENROUTER-ATIVACAO.md.
# Nunca preencher a chave neste arquivo versionado.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
SYLVINHO_IA_PROVIDER=openrouter
SYLVINHO_IA_ENABLED=false
SYLVINHO_IA_UID_ALLOWLIST=
SYLVINHO_IA_TIMEOUT_MS=20000
SYLVINHO_IA_MAX_POR_MINUTO=5
# Aprovar somente apos decisao documentada; false e o padrao seguro.
SYLVINHO_IA_INSTITUCIONAL_APROVADA=false
SYLVINHO_IA_PRIVACIDADE_APROVADA=false
SYLVINHO_IA_MENORES_APROVADA=false
SYLVINHO_IA_ZDR_APROVADO=false
SYLVINHO_IA_OPENROUTER_MODALIDADE_APROVADA=false
