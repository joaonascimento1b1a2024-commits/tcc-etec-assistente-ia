  "existingPrerequisites": [
    "functions/tsconfig.json",
    "functions/src/assistente/gemini.ts",
    "local-e2e/network-guard.cjs",
    "functions/src/avisos/email.ts",
    "functions/src/avisos/notificacoes.ts"
  ],
  "excludeFromThisCommit": [
    "knowledge-base/**",
    "public/**",
    "firestore.rules",
    "local-e2e/** (exceto network-guard.cjs ja existente e sem alteracao)",
    "arquivos nao listados em commitFiles",
    "credenciais, .env reais, backups, caches, dependencias e compilados"
