    "render-poc/commit-health.json",
    "render-poc/PUBLICACAO-HEALTH.md",
    "render-poc/test/health-only.test.cjs",
    "render-poc/test/adapter.test.cjs",
    "render-poc/test/arquitetura.test.cjs",
    "functions/package.json",
    "functions/package-lock.json",
    "functions/src/index.ts",
    "functions/src/assistente/handler.ts",
    "functions/src/assistente/http.ts",
