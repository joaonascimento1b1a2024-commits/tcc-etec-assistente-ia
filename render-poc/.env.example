# Modelo público; o servidor não carrega dotenv automaticamente.
# Modo padrão seguro, executável localmente sem credencial:
SYLVINHO_POC_MODE=health
PORT=10000
ASSISTENTE_CORS_ORIGINS=

# Somente em publicação futura explicitamente autorizada no Render:
# SYLVINHO_POC_MODE=documental
# SYLVINHO_DOCUMENTAL_ENABLED=true
# NODE_ENV=production
# RENDER=true (fornecido pela plataforma; não simular produção nos testes)
# GCLOUD_PROJECT=tcc-ia-d8891
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/sylvinho-firebase-admin.json
# SYLVINHO_SERVICE_ACCOUNT_EMAIL=sylvinho-backend@tcc-ia-d8891.iam.gserviceaccount.com
# ASSISTENTE_CORS_ORIGINS=https://tcc-ia-d8891.web.app
# Nunca colocar chave privada, JSON de credencial ou token neste arquivo.

# SYLVINHO_DEMO_ACADEMICA=false (true e rejeitado no modo documental real)
