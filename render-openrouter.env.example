# Modelo público; o servidor não carrega dotenv automaticamente.
# Modo padrão seguro, executável localmente sem credencial:
SYLVINHO_POC_MODE=health
PORT=10000
ASSISTENTE_CORS_ORIGINS=

# Somente em publicação futura explicitamente autorizada no Render:
# SYLVINHO_POC_MODE=documental
# SYLVINHO_DOCUMENTAL_ENABLED=true
# NODE_ENV=production
# RENDER=true (fornecido pela plataforma; não simular produção nos testes)
# GCLOUD_PROJECT=tcc-ia-d8891
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/sylvinho-firebase-admin.json
# SYLVINHO_SERVICE_ACCOUNT_EMAIL=sylvinho-backend@tcc-ia-d8891.iam.gserviceaccount.com
# ASSISTENTE_CORS_ORIGINS=https://tcc-ia-d8891.web.app
# Nunca colocar chave privada, JSON de credencial ou token neste arquivo.

# SYLVINHO_DEMO_ACADEMICA=false (true e rejeitado no modo documental real)

# Gemini via OpenRouter, exclusivamente no backend. Nao ha dotenv automatico.
# Cadastrar a chave real em Render > servico > Environment; nunca neste arquivo.
OPENROUTER_API_KEY=
# Catalogo consultado em 2026-10-26: JSON Schema + endpoints ZDR.
# Reconfirmar disponibilidade/termos/preco antes de ativar; sem modelo implicito.
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
SYLVINHO_IA_PROVIDER=openrouter
SYLVINHO_IA_ENABLED=false
# CSV privado: ate 20 UIDs Firebase, sem duplicatas; vazio bloqueia todos.
SYLVINHO_IA_UID_ALLOWLIST=
# Prazo TOTAL das quatro chamadas, inteiro 1..30000. Limite 1..20 por instancia.
SYLVINHO_IA_TIMEOUT_MS=20000
SYLVINHO_IA_MAX_POR_MINUTO=5
# Atestados do operador: mudar somente depois de revisao/aprovacao real.
SYLVINHO_IA_INSTITUCIONAL_APROVADA=false
SYLVINHO_IA_PRIVACIDADE_APROVADA=false
SYLVINHO_IA_MENORES_APROVADA=false
SYLVINHO_IA_ZDR_APROVADO=false
SYLVINHO_IA_OPENROUTER_MODALIDADE_APROVADA=false
# ZDR/JSON Schema sao obrigatorios no codigo. Nao ha flag para relaxa-los.
# GEMINI_API_KEY e OPENAI_API_KEY nao sao necessarias no fluxo OpenRouter.
# Demonstracao Gemini separada nao foi migrada e fica bloqueada neste provider.
