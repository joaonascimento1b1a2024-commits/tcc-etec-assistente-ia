rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // O cargo fica separado do perfil editável. Somente um administrador existente
    // pode promover outro pelo site; o primeiro é cadastrado pelo console Firebase.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.ativo == true;
    }

    match /administradores/{userId} {
      // Cada pessoa consulta o próprio cargo, mesmo quando o documento não existe.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasAll(['ativo', 'promovidoPor', 'criadoEm'])
        && request.resource.data.keys().hasOnly(['ativo', 'promovidoPor', 'criadoEm'])
        && request.resource.data.ativo == true
        && request.resource.data.promovidoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      // Revogações e reativações ficam no console, não no perfil nem no formulário.
      allow update, delete: if false;
    }

    // Contrato compartilhado pela leitura de Avisos e pelo formulário das configurações administrativas.
    function validNotice() {
      let data = request.resource.data;
      return data.keys().hasAll(['titulo', 'descricao', 'categoria', 'publicado', 'criadoEm'])
        && data.keys().hasOnly(['titulo', 'descricao', 'categoria', 'publicado', 'criadoEm', 'atualizadoEm'])
        && data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 150
        && data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 5000
        && data.categoria in ['matricula', 'provas', 'feriado', 'evento', 'geral']
        && data.publicado is bool && data.criadoEm is timestamp
        && (!('atualizadoEm' in data) || data.atualizadoEm is timestamp);
    }

    // Alunos autenticados consultam apenas publicados. Administradores também leem rascunhos.
    match /avisos/{avisoId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.publicado == true);
      allow create: if isAdmin() && validNotice() && request.resource.data.criadoEm == request.time;
      allow update: if isAdmin() && validNotice()
                    && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if isAdmin();
    }

    // Histórico privado: o UID vem da sessão, nunca de um campo editável do perfil.
    // Um documento reúne título e mensagens para que a exclusão seja completa.
    match /users/{userId}/conversas/{conversationId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validConversation() {
        let data = request.resource.data;
        return data.keys().hasAll(['titulo', 'tituloOrigem', 'mensagens', 'criadoEm', 'atualizadoEm'])
          && data.keys().hasOnly(['titulo', 'tituloOrigem', 'mensagens', 'criadoEm', 'atualizadoEm'])
          && data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 100
          && data.tituloOrigem in ['provisorio', 'manual']
          && data.mensagens is list && data.mensagens.size() > 0 && data.mensagens.size() <= 100
          && data.criadoEm is timestamp && data.atualizadoEm == request.time;
      }
      allow read, delete: if owner();
      allow create: if owner() && validConversation() && request.resource.data.criadoEm == request.time;
      allow update: if owner() && validConversation()
        && request.resource.data.criadoEm == resource.data.criadoEm;
    }

    // Cada usuário só pode acessar o próprio perfil.
    match /users/{userId} {
      // Permite ao administrador conferir um perfil pelo UID antes de promovê-lo.
      // Não dá acesso às conversas nem permite listar todos os perfis.
      allow get: if isAdmin();
      // Permite criar o próprio documento durante o cadastro.
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // Permite ler, alterar ou excluir somente o próprio documento.
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == userId;
    }
  }
}
